// Future Courier Service - Delivery Management System
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DRIVER
  MANAGER
}

enum PaymentMode {
  CASH
  BANK
}

enum OrderStatus {
  PENDING
  DELIVERED
  TRANSFER
  CANCELLED
}

enum ClosingStatus {
  SUBMITTED
  REVIEWED
}

enum BookingStatus {
  AWAITING_PICKUP
  ACCEPTED
  REJECTED
}

enum PayrollEntryType {
  PAID
  SHORT
  BONUS
}
enum ExpenseCategory {
  FUEL
  INSURANCE
  SALARY
  WORKSHOP
  CAR_WASH
  ROOM_RENT
  CAR_RENT
  STATIONARY
  PARKING
  VISA
  MEDICAL
  COMMISSION
  OTHER
  DARB
  SALIK
  INTERNET
  LICENSE
}
model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  role          Role     @default(DRIVER)
  active        Boolean  @default(true)
phone         String?
  baseSalary    Int      @default(0)
  isAgent       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordersAssigned     Order[]         @relation("OrderEmployee")
  salaryChanges      SalaryChange[]
  transfersFrom      OrderTransfer[] @relation("TransferFrom")
  transfersTo        OrderTransfer[] @relation("TransferTo")
  cashClosings       CashClosing[]
  auditLogs          AuditLog[]
expenseEntries ExpenseEntry[]
  purchases      Purchase[]
  payrolls       Payroll[]
  payrollEntries PayrollEntry[]
  agentPayments  AgentPayment[] @relation("AgentPayments")
  @@map("users")
}
// A deduction from a driver's collected cash. Optionally tagged with the vendor
// that money was actually paid out to — when tagged, it also counts toward that
// vendor's Vendor Credit "Paid" balance, and reduces the driver's real cash closing balance.
model Purchase {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([employeeId])
  @@index([vendorId])
  @@map("purchases")
}

model Vendor {
  id             String   @id @default(cuid())
  name           String   @unique
  deliveryCharge Int
  active         Boolean  @default(true)
  username       String?  @unique
  passwordHash   String?
  // "Stop today's orders" pressed at this time: later orders that day go to tomorrow's list.
  ordersStopAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders           Order[]
  bookings         Booking[]
  customerRequests CustomerRequest[]
  payments         VendorPayment[]
  driverPayments   Purchase[]
  adjustments      VendorAdjustment[]

  @@map("vendors")
}

// Manual correction to a vendor's Total Amount (e.g. fixing a data-entry mistake).
// Positive amounts add to the total; negative amounts subtract from it.
model VendorAdjustment {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  date      DateTime @db.Date
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@map("vendor_adjustments")
}

// Manual record of what an Agent has paid back to us against what they owe
// (agent credit = total they collected minus cancelled orders minus the delivery
// charge they keep as their own fee).
model AgentPayment {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation("AgentPayments", fields: [employeeId], references: [id])
  date       DateTime @db.Date
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("agent_payments")
}

// Manual record of what we've paid a vendor against their credit balance
// (credit balance = total collected on their delivered orders minus our delivery charge).
model VendorPayment {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  date      DateTime @db.Date
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([date])
  @@map("vendor_payments")
}

model Order {
  id             String      @id @default(cuid())
  date           DateTime    @db.Date
  slNo           Int
  cnNo           Int
  vendorId       String
  vendor         Vendor      @relation(fields: [vendorId], references: [id])
  // Delivery area chosen by the driver (overrides the one guessed from the address).
  area           String?
  // Driver's quick note when a delivery didn't happen ("No answer", "Customer asked tomorrow"…).
  driverNote     String?
  driverNoteAt   DateTime?
  brandName      String
  deliveryCharge Int
  total          Int
  payment        PaymentMode @default(CASH)
  // Only meaningful when payment is BANK — the driver explicitly confirms the
  // transfer actually landed. Defaults false so an un-ticked confirmation is
  // visible to admin as "unconfirmed", never silently assumed received.
  bankPaymentConfirmed Boolean @default(false)
  emirate        String      @default("DUBAI")
  employeeId     String
  employee       User        @relation("OrderEmployee", fields: [employeeId], references: [id])
  status         OrderStatus @default(PENDING)
  remarks        String?
  // When the order was marked Delivered or Cancelled. Cleared again if it is
  // moved back to Pending/Transfer. Shown next to Entry Date.
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transfers OrderTransfer[]
  booking   Booking?

  @@unique([date, slNo])
  @@index([date])
  @@index([employeeId])
  @@index([vendorId])
  @@index([status])
  @@index([cnNo])
  @@map("orders")
}

model OrderTransfer {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromEmployeeId String
  fromEmployee   User     @relation("TransferFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String
  toEmployee     User     @relation("TransferTo", fields: [toEmployeeId], references: [id])
  note           String?
  transferredAt  DateTime @default(now())

  @@index([orderId])
  @@map("order_transfers")
}

model CashClosing {
  id                  String        @id @default(cuid())
  employeeId          String
  employee            User          @relation(fields: [employeeId], references: [id])
  date                DateTime      @db.Date
  totalDelivered      Int
  totalDeliveryCharge Int
  cashPayments        Int
  onlinePayments      Int
  expenses            Int           @default(0)
  expenseRemarks      String?
  balanceCash         Int
  status              ClosingStatus @default(SUBMITTED)
  submittedAt         DateTime      @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("cash_closings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id        String   @id @default(cuid())
  name      String   @default("The Future Courier Service L.L.C")
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}
model ExpenseEntry {
  id           String          @id @default(cuid())
  date         DateTime        @db.Date
  category     ExpenseCategory
  amount       Int
  remarks      String?
  source       String          @default("ADMIN") // "ADMIN" or "DRIVER"
  employeeId   String?
  employee     User?           @relation(fields: [employeeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([employeeId])
  @@map("expense_entries")
}
model Payroll {
  id          String   @id @default(cuid())
  month       String
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  workingDays Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, employeeId])
  @@index([month])
  @@map("payrolls")
}

// Salary history: each row says "from this month on, the salary is X".
// effectiveMonth "0000-00" is the starting salary before any change.
// Lets a raise apply from a given month without changing earlier months.
model SalaryChange {
  id             String   @id @default(cuid())
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveMonth String
  baseSalary     Int
  createdAt      DateTime @default(now())

  @@unique([employeeId, effectiveMonth])
  @@index([employeeId])
  @@map("salary_changes")
}

model PayrollEntry {
  id         String           @id @default(cuid())
  month      String
  date       DateTime         @db.Date
  employeeId String
  employee   User             @relation(fields: [employeeId], references: [id])
  type       PayrollEntryType
  amount     Int
  note       String?
  createdAt  DateTime         @default(now())

  @@index([month])
  @@index([employeeId])
  @@map("payroll_entries")
}

// Admin/Manager notification feed — the bell icon. Broadcast, not per-user: any
// SUPER_ADMIN or MANAGER can see and dismiss the same feed, since these are
// operational alerts about the business, not personal messages.
model Notification {
  id        String   @id @default(cuid())
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// A consignment booked by a vendor in the Vendor Portal (or by the office on a
// vendor's behalf), with the customer's details and a printable barcode label.
// It sits in "Awaiting Pickup" until the office assigns a driver, at which point
// a normal Order is created from it and linked here (orderId).
model Booking {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  // Unique across bookings; also never reused by an Order with a different booking.
  cnNo          Int           @unique
  // Always "SYSTEM" for new bookings (generated from our own range).
  cnSource      String        @default("SYSTEM")
  // The vendor's own order/bill number (e.g. their website order 20308). Reference
  // only — never used as our CN, so it can't clash with our existing CNs.
  vendorRef     String?
  // Bill number written on a handwritten slip. Repeats over time (not unique) —
  // same vendor + bill + phone + COD is blocked as a repeat entry.
  billNo        String?
  customerName  String
  customerPhone String
  address       String
  emirate       String        @default("DUBAI")
  items         String?
  codAmount     Int
  notes         String?
  status        BookingStatus @default(AWAITING_PICKUP)
  rejectReason  String?
  // "VENDOR" or "ADMIN" — who entered it.
  createdBy     String        @default("VENDOR")
  orderId       String?       @unique
  // Website order status as last seen (processing / completed …) — website orders only.
  webStatus     String?
  // Exact delivery pin the customer shared (customer order link), for the driver's map.
  lat           Float?
  lng           Float?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  labelPrintedAt DateTime?
  // True when the order was read from a photo (handwritten slip); the photo is in BookingPhoto.
  hasPhoto      Boolean       @default(false)
  photo         BookingPhoto?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([vendorId, vendorRef])
  @@index([vendorId, billNo])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

// Small copy of a handwritten order slip that was read by the photo reader.
// Kept separate so booking lists never load image bytes. Pruned after 60 days.
model BookingPhoto {
  id        String   @id @default(cuid())
  vendorId  String
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mime      String   @default("image/jpeg")
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("booking_photos")
}

// One row per barcode scan on Scan & Assign (office) or by a driver taking a parcel.
// Kept for the daily scan report / PDF.
model ScanLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  byUserId     String
  byName       String
  byRole       String   // "OFFICE" or "DRIVER"
  driverId     String?
  driverName   String?
  code         String
  result       String   // ACCEPTED | REASSIGNED | ALREADY | FAILED
  message      String
  orderId      String?
  cnNo         Int?
  vendorName   String?
  total        Int?
  emirate      String?
  address      String?
  fromDriver   String?

  @@index([createdAt])
  @@map("scan_logs")
}

// Delivery details a customer filled in on the vendor's order link (/order/<VENDOR>).
// The vendor adds items + COD and accepts it → a normal Booking.
model CustomerRequest {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  phoneDigits   String
  address       String
  emirate       String
  landmark      String?
  notes         String?
  lat           Float?
  lng           Float?
  status        String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  bookingId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vendorId, status])
  @@index([vendorId, phoneDigits])
  @@map("customer_requests")
}

/// Highest system CN ever handed out. Never goes down, so a CN freed by a
/// deleted booking is never given to another parcel (its label may already
/// be printed and stuck on a parcel).
model CnCounter {
  id         Int @id @default(1)
  lastIssued Int @default(0) @map("last_issued")

  @@map("cn_counter")
}
