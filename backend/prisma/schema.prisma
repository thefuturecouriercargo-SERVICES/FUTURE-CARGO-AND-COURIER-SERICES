// Future Courier Service - Delivery Management System
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DRIVER
  MANAGER
}

enum PaymentMode {
  CASH
  BANK
}

enum OrderStatus {
  PENDING
  DELIVERED
  TRANSFER
  CANCELLED
}

enum ClosingStatus {
  SUBMITTED
  REVIEWED
}

enum PayrollEntryType {
  PAID
  SHORT
  BONUS
}
enum ExpenseCategory {
  FUEL
  INSURANCE
  SALARY
  WORKSHOP
  CAR_WASH
  ROOM_RENT
  CAR_RENT
  STATIONARY
  PARKING
  VISA
  MEDICAL
  COMMISSION
  OTHER
  DARB
  SALIK
  INTERNET
  LICENSE
}
model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  role          Role     @default(DRIVER)
  active        Boolean  @default(true)
phone         String?
  baseSalary    Int      @default(0)
  isAgent       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordersAssigned     Order[]         @relation("OrderEmployee")
  transfersFrom      OrderTransfer[] @relation("TransferFrom")
  transfersTo        OrderTransfer[] @relation("TransferTo")
  cashClosings       CashClosing[]
  auditLogs          AuditLog[]
expenseEntries ExpenseEntry[]
  purchases      Purchase[]
  payrolls       Payroll[]
  payrollEntries PayrollEntry[]
  @@map("users")
}
// A deduction from a driver's collected cash. Optionally tagged with the vendor
// that money was actually paid out to — when tagged, it also counts toward that
// vendor's Vendor Credit "Paid" balance, and reduces the driver's real cash closing balance.
model Purchase {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id])
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])
  amount     Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([employeeId])
  @@index([vendorId])
  @@map("purchases")
}

model Vendor {
  id             String   @id @default(cuid())
  name           String   @unique
  deliveryCharge Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders           Order[]
  payments         VendorPayment[]
  driverPayments   Purchase[]

  @@map("vendors")
}

// Manual record of what we've paid a vendor against their credit balance
// (credit balance = total collected on their delivered orders minus our delivery charge).
model VendorPayment {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  date      DateTime @db.Date
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([date])
  @@map("vendor_payments")
}

model Order {
  id             String      @id @default(cuid())
  date           DateTime    @db.Date
  slNo           Int
  cnNo           Int
  vendorId       String
  vendor         Vendor      @relation(fields: [vendorId], references: [id])
  brandName      String
  deliveryCharge Int
  total          Int
  payment        PaymentMode @default(CASH)
  emirate        String      @default("DUBAI")
  employeeId     String
  employee       User        @relation("OrderEmployee", fields: [employeeId], references: [id])
  status         OrderStatus @default(PENDING)
  remarks        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transfers OrderTransfer[]

  @@unique([date, slNo])
  @@index([date])
  @@index([employeeId])
  @@index([vendorId])
  @@index([status])
  @@index([cnNo])
  @@map("orders")
}

model OrderTransfer {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromEmployeeId String
  fromEmployee   User     @relation("TransferFrom", fields: [fromEmployeeId], references: [id])
  toEmployeeId   String
  toEmployee     User     @relation("TransferTo", fields: [toEmployeeId], references: [id])
  note           String?
  transferredAt  DateTime @default(now())

  @@index([orderId])
  @@map("order_transfers")
}

model CashClosing {
  id                  String        @id @default(cuid())
  employeeId          String
  employee            User          @relation(fields: [employeeId], references: [id])
  date                DateTime      @db.Date
  totalDelivered      Int
  totalDeliveryCharge Int
  cashPayments        Int
  onlinePayments      Int
  expenses            Int           @default(0)
  expenseRemarks      String?
  balanceCash         Int
  status              ClosingStatus @default(SUBMITTED)
  submittedAt         DateTime      @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("cash_closings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanySettings {
  id        String   @id @default(cuid())
  name      String   @default("The Future Courier Service L.L.C")
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}
model ExpenseEntry {
  id           String          @id @default(cuid())
  date         DateTime        @db.Date
  category     ExpenseCategory
  amount       Int
  remarks      String?
  source       String          @default("ADMIN") // "ADMIN" or "DRIVER"
  employeeId   String?
  employee     User?           @relation(fields: [employeeId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([employeeId])
  @@map("expense_entries")
}
model Payroll {
  id          String   @id @default(cuid())
  month       String
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id])
  workingDays Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, employeeId])
  @@index([month])
  @@map("payrolls")
}

model PayrollEntry {
  id         String           @id @default(cuid())
  month      String
  date       DateTime         @db.Date
  employeeId String
  employee   User             @relation(fields: [employeeId], references: [id])
  type       PayrollEntryType
  amount     Int
  note       String?
  createdAt  DateTime         @default(now())

  @@index([month])
  @@index([employeeId])
  @@map("payroll_entries")
}
